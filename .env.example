# Server Environment Variables

# The port Nuxt will run on
PORT=8080

# The JWT Secret used for signing WebSocket access and refresh tokens.
# Must be a long, secure random string. If empty, a random one will be generated at startup, 
# but tokens will NOT survive server restarts. It is highly recommended to set this!
JWT_SECRET=your_super_secret_jwt_signing_key_here

# (Optional) Force the client to use wss:// regardless of the environment
# FORCE_WSS=true
